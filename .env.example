# App Store Connect API (required)
ASC_ISSUER_ID=your-issuer-id
ASC_KEY_ID=your-key-id
ASC_PRIVATE_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8

# Apple Ads Platform API (optional — enables the search term popularity and
# keyword suggestion tools). These are SEPARATE credentials from the App Store
# Connect ones above; the ASC .p8 will not authenticate against Apple Ads.
# Generate an EC P-256 key pair and register the public key at
# ads.apple.com -> Account Settings -> API. Requires a set-up Apple Ads account.
# APPLE_ADS_CLIENT_ID=SEARCHADS.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# APPLE_ADS_TEAM_ID=SEARCHADS.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# APPLE_ADS_KEY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# APPLE_ADS_PRIVATE_KEY_PATH=/path/to/apple-ads-private-key.pem

# Run the list_ad_accounts tool to find this; every other Apple Ads tool needs it.
# APPLE_ADS_AD_ACCOUNT_ID=your-ad-account-id

# Override only when testing against a non-production host.
# APPLE_ADS_BASE_URL=https://api.ads.apple.com
