{
  "name": "appstoreconnect-mcp",
  "version": "0.1.0",
  "description": "MCP server for App Store Connect API",
  "type": "module",
  "bin": {
    "appstoreconnect-mcp": "./build/index.js"
  },
  "scripts": {
